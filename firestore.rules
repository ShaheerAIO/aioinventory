rules_version = '2';

// AIO Inventory — Firestore security rules
//
// Collections in play:
//   inventory/main       all app data except the movement ledger and audits
//   inventory/movements  the movement ledger (split out in v107)
//   audits/{auditId}     one doc per stock audit (split out in v107)
//   users/{uid}          { name, email, role } — role is 'superadmin' | 'admin' | 'edit' | 'view'
//                        (superadmin = admin + may rewrite any unit's properties in the app)
//   activityLog/{id}     permanent who-did-what log, written by js/activity.js
//
// Cloud Functions use firebase-admin and bypass these rules entirely.

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Who is asking ─────────────────────────────────────────────────
    function signedIn() {
      return request.auth != null;
    }
    function profile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function hasProfile() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }
    function isSuperAdmin() {
      return hasProfile() && profile().role == 'superadmin';
    }
    function isAdmin() {
      return hasProfile() && profile().role in ['superadmin', 'admin'];
    }
    function canEdit() {
      return hasProfile() && profile().role in ['superadmin', 'admin', 'edit'];
    }
    function email() {
      return request.auth.token.email.lower();
    }

    // ── Inventory data ────────────────────────────────────────────────
    // Everyone signed in can read; only editors and admins can write.
    match /inventory/{docId} {
      allow read:   if signedIn();
      allow create: if isAdmin();          // only the v107 storage split creates docs
      allow update: if canEdit() && pendingUsersOk();
      allow delete: if false;              // nothing in the app deletes these
    }

    // inventory/main also carries pendingUsers — the pre-assigned roles that
    // decide what someone becomes on their first sign-in. Writing that map is
    // effectively granting a role, so it is admin-only, with one exception: a
    // new user clears their own entry as they consume it.
    function pendingUsersOk() {
      let before = resource.data.get('pendingUsers', {});
      let after  = request.resource.data.get('pendingUsers', {});
      let d      = before.diff(after);
      return d.affectedKeys().size() == 0
          || isAdmin()
          || ( d.addedKeys().size() == 0
            && d.changedKeys().size() == 0
            && request.auth.token.email != null
            && d.removedKeys().hasOnly([email()]) );
    }

    // ── Stock audits ──────────────────────────────────────────────────
    match /audits/{auditId} {
      allow read:                 if signedIn();
      allow create, update, delete: if canEdit();
    }

    // ── Activity log ──────────────────────────────────────────────────
    // Append-only and permanent. Anyone signed in writes entries as they act,
    // but only as themselves (uid + email come from their sign-in token) and
    // stamped with the server's clock. Nobody — admins included — can edit or
    // delete an entry from the app; only admins can read the log.
    match /activityLog/{entryId} {
      allow read:   if isAdmin();
      allow create: if signedIn()
        && request.auth.token.email != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.at == request.time
        && request.resource.data.keys().hasOnly(
             ['at', 'clientAt', 'uid', 'email', 'name', 'role', 'summary', 'actions', 'serials', 'detail']);
      allow update, delete: if false;
    }

    // ── User profiles and roles ───────────────────────────────────────
    // Readable by anyone signed in: the servicing screen's "tested by"
    // dropdown lists users, and first sign-in looks for a profile to join.
    match /users/{uid} {
      allow read: if signedIn();

      // A user may create only their own profile, only carrying their own
      // email, and only at 'view' — unless an admin pre-assigned a higher
      // role, or they are inheriting one from their own older profile.
      // superadmin can never come from a pre-assignment: an admin can write
      // pendingUsers, so allowing it would let an admin mint a super admin.
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.auth.token.email != null
        && request.resource.data.email == request.auth.token.email
        && ( request.resource.data.role == 'view'
          || (request.resource.data.role == pendingRole()
              && request.resource.data.role != 'superadmin')
          || joinedFromOwnProfile() );

      // Role changes, removal and reactivation are admin-only, and anything
      // that touches a super admin — granting it, or changing, removing or
      // reactivating someone who has it — is super-admin-only. The one
      // exception is stamping migratedTo on an old profile that carries the
      // writer's own email, which is how first sign-in retires it.
      allow update: if isSuperAdmin()
        || (isAdmin()
            && resource.data.get('role', '') != 'superadmin'
            && request.resource.data.get('role', '') != 'superadmin')
        || retiringOwnOldProfile();

      allow delete: if false;              // removal is a soft delete
    }

    // The role an admin pre-assigned to this email, or 'view' if none
    function pendingRole() {
      return get(/databases/$(database)/documents/inventory/main).data
               .get('pendingUsers', {})
               .get(email(), {})
               .get('role', 'view');
    }

    // True when the role being claimed comes from an older, still-active
    // profile that carries this same user's email address
    function joinedFromOwnProfile() {
      let src = request.resource.data.get('joinedFrom', '');
      return src != ''
        && exists(/databases/$(database)/documents/users/$(src))
        && srcData(src).email.lower() == email()
        && srcData(src).role == request.resource.data.role
        && srcData(src).get('deleted', false) == false;
    }
    function srcData(src) {
      return get(/databases/$(database)/documents/users/$(src)).data;
    }

    // First sign-in retires the old profile by stamping migratedTo on it.
    // Only allowed on a profile holding the writer's own email, and only if
    // nothing else about it changes.
    function retiringOwnOldProfile() {
      return signedIn()
        && request.auth.token.email != null
        && resource.data.email.lower() == email()
        && request.resource.data.diff(resource.data)
             .affectedKeys().hasOnly(['migratedTo', 'migratedAt'])
        && request.resource.data.migratedTo == request.auth.uid;
    }
  }
}
